APP_NAME=KBO Travel API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=baseballtour.firebasestorage.app
TOUR_API_KEY=
TOUR_API_CONNECT_TIMEOUT_SECONDS=5
TOUR_API_READ_TIMEOUT_SECONDS=10
TOUR_API_WRITE_TIMEOUT_SECONDS=5
TOUR_API_POOL_TIMEOUT_SECONDS=5
TOUR_API_MAX_ATTEMPTS=2
TOUR_API_RETRY_BACKOFF_SECONDS=0.25
TOUR_API_PERSISTENT_CACHE_ENABLED=true
KAKAO_REST_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
